# ==============================================================================
# Hammerspoon Powerhouse — Environment Configuration Template
# Copy this file to ~/.hammerspoon/.env (gitignored) or place keys in ~/.env.
# ~/.hammerspoon/.env takes precedence over ~/.env for machine-specific overrides.
# ==============================================================================

# --- Module Toggles (1 = enabled, 0 = disabled) ---
# ENABLE_COMMAND_PALETTE=1
# ENABLE_MENUBAR_HUB=1
# ENABLE_SPOONS=1
# ENABLE_AI_CHATBOX=1
# ENABLE_IMAGE_SCRAPER=1
# ENABLE_TERMINAL_SERVER=1
# ENABLE_MAGNIFIER=1
# ENABLE_TRANSLATOR=1
# ENABLE_TTS=1
# ENABLE_TEXT_REFINER=1
# ENABLE_KEYSTROKE_VIS=1
# ENABLE_WINDOW_OVERLAY=1
# ENABLE_NIGHTSHADE=0

# --- AI & LLM Providers (optional — modules without keys degrade gracefully) ---
# OpenRouter API key (AI Chatbox, OpenRouter TTS, Cliffnotes Summarization, Text Refiner fallback)
OPENROUTER_API_KEY=

# xAI / Grok API key (Primary provider for Text Refiner & inline translation)
XAI_API_KEY=

# OpenAI API key (Alternative provider for Text Refiner)
OPENAI_API_KEY=

# Optional Text Refiner endpoint/model overrides
# TEXT_REFINER_URL=https://api.x.ai/v1/chat/completions
# TEXT_REFINER_MODEL=grok-4.20-non-reasoning-latest

# --- Read Aloud / Text-to-Speech (⌃⌥S / ⌃⌥⇧S) ---
# Engine: auto | kokoro | openrouter | say  (default: auto)
#   auto picks local Kokoro if KOKORO_TTS_DIR exists -> OpenRouter if API key set -> macOS say
# TTS_ENGINE=auto
# TTS_MODEL=qwen/qwen-audio-3.0-tts-flash
# TTS_VOICE=loongjohn
# SUMMARY_MODEL=deepseek/deepseek-v4-flash

# Optional local offline Kokoro-82M runtime directory
# KOKORO_TTS_DIR=~/path/to/kokoro-tts
# KOKORO_TTS_MODEL_DIR=~/path/to/kokoro-tts/weights/Kokoro-82M-bf16
# KOKORO_TTS_PYTHON=~/path/to/kokoro-tts/.venv/bin/python
# KOKORO_TTS_VOICE=bm_george
# KOKORO_TTS_SPEED=1.0
# Optional pgrep pattern for memory-pressure warnings when batch TTS jobs run
# KOKORO_CONFLICT_PATTERN=

# --- Image Scraper ---
# Output directory for batch-downloaded images
# IMAGE_SCRAPER_DIR=~/Downloads/scraped-images

# --- Mouse Magnifier & Hardware Screen Recorder ---
# MAGNIFIER_RECORDINGS_PATH=~/Movies/Screen Captures
# MAGNIFIER_FPS=25
# MAGNIFIER_RECORD_FPS=30
# MAGNIFIER_RECORD_AUDIO=0
# MAGNIFIER_EXPORT_GIF=1
# MAGNIFIER_EXPORT_WEBM=0
# MAGNIFIER_CLICK_DURATION=0.6
# MAGNIFIER_CLICK_PULSE=0.04
# MAGNIFIER_CURSOR_PATH=~/.hammerspoon/assets/cursor_hand.png

# --- Optional Binary Overrides (auto-detected on Apple Silicon & Intel Macs) ---
# FFMPEG_PATH=/opt/homebrew/bin/ffmpeg
# GIFSKI_PATH=/opt/homebrew/bin/gifski
