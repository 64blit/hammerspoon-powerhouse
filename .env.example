# ==============================================================================
# Hammerspoon Powerhouse - Environment Configuration Template
# Copy this file to `~/.hammerspoon/.env` or populate `~/.env`
# ==============================================================================

# --- AI & LLM Providers ---
# OpenRouter API key (Used for AI Chatbox and OpenRouter TTS)
OPENROUTER_API_KEY=your_openrouter_api_key_here

# xAI / Grok API key (Used for Text Refiner)
XAI_API_KEY=your_xai_api_key_here

# OpenAI API key (Alternative for TTS, Text Refiner, and Chatbox)
OPENAI_API_KEY=your_openai_api_key_here

# Google Gemini API key (Alternative provider for AI Chatbox)
GEMINI_API_KEY=your_gemini_api_key_here

# Groq API key (Ultra-fast LLM inference fallback)
GROQ_API_KEY=your_groq_api_key_here

# --- 64blit Code Intelligence Configuration ---
# URL for the Code Intelligence MCP/HTTP Server (default: http://127.0.0.1:9991)
CODE_INTEL_URL=http://127.0.0.1:9991

# Custom path to 64blit-code-intel CLI binary (leave blank for automatic PATH lookup)
# CODE_INTEL_BIN=/usr/local/bin/64blit-code-intel

# Default directory for scraped Markdown docs (default: ~/Documents/Crawls)
# CODE_INTEL_CRAWLS_DIR=~/Documents/Crawls

# --- Screen Recorder & Magnifier ---
# Base path for saving magnifier screen recordings
# MAGNIFIER_RECORDINGS_PATH=~/Movies/Screen Captures
